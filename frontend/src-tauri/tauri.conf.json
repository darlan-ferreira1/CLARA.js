{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CLARA",
  "version": "0.1.0",
  "identifier": "io.github.darlanferreira1.clarajs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173/",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CLARA.js",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Laboratórios virtuais de Ciências",
    "longDescription": "Experimentos interativos de Física, Química e Biologia para o ensino médio, com 3D, Museu Virtual e interação por gestos da mão pela webcam.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
